#!/usr/bin/env bash
# 假 herdr：把每個呼叫記到 $OPSX_FAKE_LOG，回合理的 JSON。測試用。
# agent prompt / agent wait 會呼叫 $OPSX_TEST_ON_PROMPT / $OPSX_TEST_ON_WAIT（若設定；wait 的拿到整串參數），讓測試推進 fixture 的狀態。
printf '%s\n' "$*" >> "${OPSX_FAKE_LOG:?}"
pop_err() { # <file>：印第一行並刪掉它；ok 或沒檔印空
  [ -n "$1" ] && [ -s "$1" ] || return 0
  local first; first="$(head -1 "$1")"; tail -n +2 "$1" > "$1.tmp"; mv "$1.tmp" "$1"
  [ "$first" = ok ] || printf '%s' "$first"
}
herdr_err() { echo '{"error":{"code":"'"$1"'","message":"fake"},"id":"cli:agent:'"$2"'"}' >&2; exit 1; }
case "$1 $2" in
  # 真格式見 herdr-samples/workspace-create.json（2026-11-06 實跑）：result.workspace.workspace_id；這裡只回用到的欄位
  "workspace create") echo '{"id":"cli:workspace:create","result":{"workspace":{"workspace_id":"w9","label":"'"${4:-}"'"},"type":"workspace_created"}}' ;;
  "workspace list") cat "$(dirname "${BASH_SOURCE[0]}")/herdr-samples/workspace-list.json" ;;
  "tab create") cat "$(dirname "${BASH_SOURCE[0]}")/herdr-samples/tab-create.json" ;;   # 真格式：result.root_pane.pane_id / result.tab.tab_id
  # OPSX_TEST_BUSY_LEFT 指到一個計數檔：>0 時回 herdr 的 agent_pane_busy（真格式）並遞減，模擬 shell 還沒到 prompt
  "agent start")
    if [ -n "${OPSX_TEST_BUSY_LEFT:-}" ] && [ "$(cat "$OPSX_TEST_BUSY_LEFT")" -gt 0 ]; then
      echo "$(( $(cat "$OPSX_TEST_BUSY_LEFT") - 1 ))" > "$OPSX_TEST_BUSY_LEFT"
      echo '{"error":{"code":"agent_pane_busy","message":"agent target pane '"$7"' is not an available shell"},"id":"cli:agent:start"}' >&2; exit 1
    fi
    if [ -n "${OPSX_TEST_START_FAIL:-}" ]; then
      msg=nope; [ "$OPSX_TEST_START_FAIL" = agent_name_taken ] && msg="agent name $3 is already used; candidates: terminal_id=term_1 pane_id=w9:p1 workspace_id=w9 tab_id=w9:t1 cwd=/x status=Working"
      echo '{"error":{"code":"'"$OPSX_TEST_START_FAIL"'","message":"'"$msg"'"},"id":"cli:agent:start"}' >&2; exit 1
    fi
    # OPSX_TEST_NOT_READY_ONCE 指到一個檔：存在就回一次 agent_not_ready（Claude 啟動停在對話框）並刪掉它
    if [ -n "${OPSX_TEST_NOT_READY_ONCE:-}" ] && [ -f "$OPSX_TEST_NOT_READY_ONCE" ]; then
      rm -f "$OPSX_TEST_NOT_READY_ONCE"
      echo '{"error":{"code":"agent_not_ready","message":"agent '"$3"' is blocked during startup and is not ready for prompts"},"id":"cli:agent:start"}' >&2; exit 1
    fi
    echo '{"result":{"ok":true}}' ;;
  "tab close") echo '{"id":"cli:tab:close","result":{"type":"ok"}}' ;;
  # pane 畫面用 OPSX_TEST_PANE_TEXT 當內容：wait-output 找得到 --match 的字就成功，否則 rc 1
  "pane wait-output") case "${OPSX_TEST_PANE_TEXT:-}" in *"$4"*) echo '{"result":{"matched":true}}' ;; *) echo '{"error":{"code":"timeout"}}' >&2; exit 1 ;; esac ;;
  # OPSX_TEST_PANE_READ_FAIL 設了就非 0 結束（模擬 pane 已死）
  # OPSX_TEST_PANE_ONCE 指向的檔存在時，第一次讀回它的內容並刪掉，之後回 OPSX_TEST_PANE_TEXT
  "pane read")
    [ -z "${OPSX_TEST_PANE_READ_FAIL:-}" ] || herdr_err pane_not_found read
    if [ -n "${OPSX_TEST_PANE_ONCE:-}" ] && [ -f "$OPSX_TEST_PANE_ONCE" ]; then cat "$OPSX_TEST_PANE_ONCE"; rm -f "$OPSX_TEST_PANE_ONCE"
    else printf '%s\n' "${OPSX_TEST_PANE_TEXT:-}"; fi ;;
  "pane send-keys") echo '{"result":{"type":"ok"}}' ;;
  # 真格式（2026-11-06 在 pane 裡實跑存下來）：{"id":"cli:agent:list","result":{"agents":[{pane_id:"w1:p2",agent_status,…}],"type":"agent_list"}}
  "agent list")
    # OPSX_TEST_HERDR_LIST_FAIL 設了就把它的值當 stderr 原文、非 0 結束（模擬 socket 連不到）
    if [ -n "${OPSX_TEST_HERDR_LIST_FAIL:-}" ]; then printf '%s\n' "$OPSX_TEST_HERDR_LIST_FAIL" >&2; exit 1; fi
    cat "${OPSX_TEST_HERDR_AGENTS:-$(dirname "${BASH_SOURCE[0]}")/herdr-samples/agent-list.json}" ;;
  "pane list") cat "${OPSX_TEST_HERDR_PANES:-$(dirname "${BASH_SOURCE[0]}")/herdr-samples/pane-list.json}" ;;
  # 真格式（2026-11-06 在 pane w5:pH 實跑）：TARGET 吃 dispatch.json 的 pane id，--format text 是純文字
  # OPSX_TEST_AGENT_READ 指到一個檔：當畫面內容（coordinate 偵測用量上限用）
  "agent read") cat "${OPSX_TEST_AGENT_READ:-$(dirname "${BASH_SOURCE[0]}")/herdr-samples/agent-read.txt}" ;;
  # OPSX_TEST_PROMPT_ERR / OPSX_TEST_WAIT_ERR 指到一個檔，每行一個 herdr 錯誤碼：每次呼叫取走第一行，是 ok 或檔空了就照常成功
  # opsx-coordinator 預設不存在（agent_not_found）；OPSX_TEST_COORDINATOR_UP 設了才在，OPSX_TEST_COORD_ERR 指到一個檔時每次取走一行錯誤碼
  "agent prompt")
    if [ "$3" = opsx-coordinator ]; then
      [ -n "${OPSX_TEST_COORDINATOR_UP:-}" ] || herdr_err agent_not_found prompt
      code="$(pop_err "${OPSX_TEST_COORD_ERR:-}")"; [ -n "$code" ] && herdr_err "$code" prompt
      echo '{"result":{"submitted":true}}'; exit 0
    fi
    code="$(pop_err "${OPSX_TEST_PROMPT_ERR:-}")"; [ -n "$code" ] && herdr_err "$code" prompt
    [ -n "${OPSX_TEST_ON_PROMPT:-}" ] && bash "$OPSX_TEST_ON_PROMPT" "$4"; echo '{"result":{"submitted":true}}' ;;
  "agent wait") code="$(pop_err "${OPSX_TEST_WAIT_ERR:-}")"; [ -n "$code" ] && herdr_err "$code" wait
    [ -n "${OPSX_TEST_ON_WAIT:-}" ] && bash "$OPSX_TEST_ON_WAIT" "$@"; echo '{"result":{"status":"idle"}}' ;;
  # OPSX_TEST_RENAME_FAIL 設了就回 herdr 的錯誤（auto-dispatch 的佇列 hook 用）
  "agent rename") if [ -n "${OPSX_TEST_RENAME_FAIL:-}" ]; then echo '{"error":{"code":"agent_not_found","message":"no agent named '"$3"'"},"id":"cli:agent:rename"}' >&2; exit 1; fi
                  echo '{"result":{"renamed":true}}' ;;
  # OPSX_TEST_PANE_CLOSE_FAIL 設了就回錯誤碼（pane 已經不在）
  "pane close") if [ -n "${OPSX_TEST_PANE_CLOSE_FAIL:-}" ]; then echo '{"error":{"code":"'"$OPSX_TEST_PANE_CLOSE_FAIL"'","message":"no pane '"$3"'"},"id":"cli:pane:close"}' >&2; exit 1; fi
                echo '{"result":{"closed":true}}' ;;
  "pane focus") echo '{"result":{"focused":true}}' ;;
  "agent focus") echo '{"result":{"focused":true}}' ;;
  "plugin list") cat "${OPSX_TEST_HERDR_PLUGINS:-/dev/null}"; echo ;;
  "plugin link") echo '{"result":{"linked":true}}' ;;
  # OPSX_TEST_NOTIFY_ERR 跟 OPSX_TEST_PROMPT_ERR 一樣：每次呼叫取走一行，非 ok 就回那個錯誤碼
  "notification show") code="$(pop_err "${OPSX_TEST_NOTIFY_ERR:-}")"
    if [ -n "$code" ]; then echo '{"error":{"code":"'"$code"'","message":"fake"},"id":"cli:notification:show"}' >&2; exit 1; fi
    echo '{"result":{"type":"ok"}}' ;;
  "pane current") echo '{"result":{"pane_id":"p42"}}' ;;
  "pane report-metadata") echo '{"result":{"ok":true}}' ;;
  # 真 usage：herdr plugin pane focus <PANE_ID>，只收一個 positional
  "plugin pane") if [ "$3" = focus ] && [ "$#" -ne 4 ]; then echo "usage: herdr plugin pane focus <PANE_ID>" >&2; exit 2; fi; echo '{"result":{}}' ;;
  *) echo '{"result":{}}' ;;
esac
