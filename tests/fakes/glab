#!/usr/bin/env bash
# 假 glab：`glab mr view <iid> -F json` 回 $OPSX_TEST_GLAB_JSON 檔的內容；
# 設了 $OPSX_TEST_GLAB_JSON_BY_IID 就回 ${OPSX_TEST_GLAB_JSON_BY_IID}<iid>.json（多條 MR 的測試）。
printf '%s\n' "$*" >> "${OPSX_FAKE_LOG:?}"
case "$1 $2" in
  "mr view") if [ -n "${OPSX_TEST_GLAB_JSON_BY_IID:-}" ] && [ -f "${OPSX_TEST_GLAB_JSON_BY_IID}$3.json" ]; then cat "${OPSX_TEST_GLAB_JSON_BY_IID}$3.json"; else cat "${OPSX_TEST_GLAB_JSON:?}"; fi ;;
  *) echo '{}' ;;
esac
