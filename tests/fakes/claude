#!/usr/bin/env bash
# 假 claude：每次呼叫記一行 JSON 到 $OPSX_FAKE_LOG（cwd、argv、--settings 檔的內容），
# 再把一行假紀錄寫進真 claude 存 transcript 的位置：$CLAUDE_CONFIG_DIR/projects/<cwd 非英數字換成 ->/<id>.jsonl。
python3 -I - "$@" >> "${OPSX_FAKE_LOG:?}" <<'PY'
import json, os, sys
argv = sys.argv[1:]
settings = None
if "--settings" in argv:
    settings = json.load(open(argv[argv.index("--settings") + 1]))
print(json.dumps({"cwd": os.getcwd(), "argv": argv, "settings": settings}, ensure_ascii=False))
PY
id=""
prev=""
for a in "$@"; do
  case "$prev" in --session-id|--resume) id="$a" ;; esac
  prev="$a"
done
dir="${CLAUDE_CONFIG_DIR:?}/projects/$(pwd -P | sed 's/[^a-zA-Z0-9]/-/g')"
mkdir -p "$dir"
printf '{"session":"%s","call":"%s"}\n' "$id" "$1" >> "$dir/$id.jsonl"
