{
  "permissions": {
    "allow": [
      "Bash(opsx status *)",
      "Bash(opsx log *)",
      "Bash(openspec status *)",
      "Bash(openspec instructions *)",
      "Bash(openspec list *)"
    ],
    "additionalDirectories": ["${OPSX_STATE_DIR}"]
  },
  "sandbox": {
    "excludedCommands": ["gh pr *", "gh issue comment *", "orca status *", "orca repo list *", "orca repo add *", "orca repo set *", "orca worktree list *", "orca tab create *", "orca terminal read *"],
    "filesystem": {
      "denyWrite": [
        "${OPSX_STATE_DIR}/grants.toml",
        "${OPSX_STATE_DIR}/python",
        "${OPSX_STATE_DIR}/coordinator-settings.json"
      ]
    }
  }
}
