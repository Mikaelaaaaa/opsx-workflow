#!/usr/bin/env bash
# opsx — opsx-workflow 的 CLI 入口。子命令各一檔在 bin/lib/<cmd>.sh。
# 要求檔 §3.6「CLI helper」。裝法：/opsx init 第一次跑會 symlink 到 ~/.local/bin/opsx。
set -euo pipefail

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  dir="$(cd "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$dir/$self";; esac
done
OPSX_ROOT="${OPSX_ROOT:-$(cd "$(dirname "$self")/.." && pwd)}"
export OPSX_ROOT
export OPSX_STATE_DIR="${OPSX_STATE_DIR:-$HOME/.local/state/opsx}"

usage() {
  cat <<'EOF'
opsx <command> [args]

  init [--global|--check]              在 repo 根目錄裝 openspec + opsx schema + 登記來源；--global 裝一次 CLI 與全域設定；--check 只讀，比對設定與 templates/settings.opsx.json
  status <phase> <n>/<total> <label…>  寫 changes/<slug>/status.json（--tests green|red · --change <slug> · --sub <子> · --worker <誰> · --show）
  check <主 change>                   檢查 subs/ 底下每個子殼齊不齊，有缺項逐條印、退出 1
  dispatch <slug> [--agent --model --mode --kind --repo --note <指示>]   派工：worktree + herdr tab + agent start + 第一句 + dispatch.json；--note 在第一句前寫進 inbox.md ## 派工指示
  dispatch --feature <feature> [--agent --model --mode --repo]   一個 session 代管 feature 現在能開工的主 change（不起 drive）
  note <slug> [--repo] <指示…>          派工指示寫進 inbox.md ## 派工指示（追加一行）；卡已派出就送進 agent
  next                                 feature session 的主 change 等合併時，印同 feature 下一個主 change 的 /<stage> <主>，沒有印 none
  stack <主> <子> <sha>               在 PR 分支上 cherry-pick 子 change 的 commit、勾主殼 tasks.md；衝突 abort 退出 3
  drive <slug> [--repo]                「開到可合併」迴圈（dispatch --mode autopilot 會自己跑；手動跑也會登記 pid）
  coordinate [--dry]                   中控跑一輪：收尾已合併的卡、答 gate、重派死掉的卡、派待指派的卡（不合併；launchd 每 5 分鐘）
  stop <slug> [--repo]                 停：kill drive、關 pane、dispatch.json 標 stopped
  reap [--pane <id>] [--dry]           關孤兒 pane：卡已歸檔 / 已拆 / stopped，agent 是 idle，pane 上沒有活卡（coordinate 每輪跑；看板「關閉」）
  collect [--root ~/code] [--state …]  看板的資料：掃 repo 的卡 + 全域狀態 + herdr / glab，印一份 JSON（不寫檔）
  answer <slug> --gate <id> [--grant this|card|repo] <text…>   回 gate：gates.md answered、授權落檔、decisions、herdr agent prompt
  new [--repo <path>] -- <一句話>       ＋新增收件卡（source: me）；不給 repo 就進 <state>/unfiled/ 待分類，印 slug
  file <slug> --repo <path>            待分類搬進 repo：unfiled/<slug>.md 原樣變成殼的 inbox.md
  drop <slug> [--repo <path>] -- <理由>  捨棄：歸檔並標 outcome: declined；不給 repo 就把待分類移到 unfiled/dropped/
  sync [--source gitlab|github|debt]   撈 sources.toml 的 issue 與 shortcut: 註解進收件匣，去重；每次在 <state>/sync.log 記一行
  merge <slug> [--repo]                核准合併：重驗五條件、dispatch.json 寫一次性核准、叫 agent /babysit merge（不自己 glab mr merge）
  priority <slug> [--set P0|P1|P2 --reason <理由>] [--repo]   印卡的等級與理由（依事實算）；--set 由使用者覆寫，記 decisions.tsv
  log <slug> <who> <tag> <文字> [證據] [--repo]   在卡的 decisions.tsv 記一列（tag：已允許 已決定 替你決定 已指派 已停止 已合併 同步 驗證）
  log --sync <source> <新卡數> <文字>   在 <state>/sync.log 記一次同步
  timeline [--root ~/code] [--state …] [--since <iso>]   跨卡時間軸：所有卡的 decisions.tsv，印一份 JSON（不寫檔）
EOF
}

cmd="${1:-}"
case "$cmd" in
  ""|-h|--help|help) usage; [ -n "$cmd" ] && exit 0 || exit 2 ;;
esac
shift
lib="$OPSX_ROOT/bin/lib/$cmd.sh"
if [ ! -f "$lib" ]; then
  echo "opsx: 沒有這個子命令：$cmd" >&2
  usage >&2
  exit 2
fi
# shellcheck source=/dev/null
source "$OPSX_ROOT/bin/lib/common.sh"
# shellcheck source=/dev/null
source "$OPSX_ROOT/bin/lib/stage.sh"
# shellcheck source=/dev/null
source "$OPSX_ROOT/bin/lib/log.sh"
# shellcheck source=/dev/null
source "$OPSX_ROOT/bin/lib/python.sh"
# init --global 是寫這個檔的人，只有它可以在沒有檔的時候跑
if [ "$cmd" != init ] || [ "${1:-}" != --global ]; then opsx_python_load || die "$OPSX_PY_ERR"; fi
# shellcheck source=/dev/null
source "$lib"
"opsx_$cmd" "$@"
